{
  "name": "codex-telegram-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node dist/src/main.js",
    "supervise": "npm run build && node scripts/supervisor.mjs",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:ui": "npm run build && playwright test --config frontend/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "swagger-ui-dist": "^5.33.0",
    "tailwind-merge": "^3.7.0"
  }
}
