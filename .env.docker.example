# Copie para .env.docker e preencha os valores antes de iniciar.
# Nunca publique este arquivo preenchido nem a chave da API.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_CHAT_ID=

# Este caminho existe dentro do container. O diretório do host é definido abaixo.
PROJECTS_JSON=[{"id":"demo","name":"Projeto demo","cwd":"/workspace/projects/demo"}]
PROJECTS_HOST_DIR=./projects

CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_MODELS_JSON=[]
CODEX_REASONING_EFFORTS_JSON=["low","medium","high"]
# Alternativa ao login persistido no volume codex-home.
OPENAI_API_KEY=

DB_PATH=/app/data/bridge.sqlite
HTTP_HOST=0.0.0.0
HTTP_PORT=8787
HOST_HTTP_PORT=8787

AUDIO_ENABLED=false
AUDIO_MODEL=base
AUDIO_MODEL_CACHE_DIR=/opt/whisper-models

# Usado somente no build da imagem para fixar a versão do Codex CLI.
CODEX_VERSION=0.158.0
